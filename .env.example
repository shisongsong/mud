NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Supabase shared Transaction Pooler connection string. Replace the password locally and never commit it.
# URL-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT-REF:REPLACE_WITH_URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# Optional; only used in production when strict TLS certificate verification is enabled.
DATABASE_SSL_CA_FILE=../../.secrets/supabase-root.crt

# Redis is used for ephemeral presence/rate-limit/cache data, never durable events.
REDIS_URL=redis://127.0.0.1:6379
