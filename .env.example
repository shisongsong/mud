NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# SQL Server connection settings; credentials are intentionally blank.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=mud
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false

# Redis is used for ephemeral presence/rate-limit/cache data, never durable events.
REDIS_URL=redis://127.0.0.1:6379
